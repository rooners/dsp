Meta.AppConfigId=a3e2182d-e221-4d1a-a035-7c87cbbdc512
Meta.DisplayName=Dyson Sphere Program (Nebula Mod)
Meta.Description=Headless dedicated server for Dyson Sphere Program powered by Wine, BepInEx, and the Nebula Multiplayer Mod.
Meta.Author=Community
Meta.URL=https://github.com/NebulaModTeam/nebula
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.ConfigRoot=dysonsphereprogramnebula.kvp
Meta.ConfigManifest=dysonsphereprogramnebulaconfig.json
Meta.MetaConfigManifest=dysonsphereprogramnebulametaconfig.json
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The server requires Wine and Xvfb to run on Linux. Using a container avoids needing to install these dependencies on the host.
Meta.DisplayImageSource=steam:1366540
Meta.MinAMPVersion=2.5.0.0

App.DisplayName=Dyson Sphere Program (Nebula Mod)
App.RootDir=./GenericApplication/
App.WorkingDir=./GenericApplication/
App.Ports=@IncludeJson[dysonsphereprogramnebulaports.json]
App.PrimaryApplicationPortRef=NebulaPort

App.ExecutableWin=DSPGAME.exe
App.ExecutableLinux=/usr/bin/xvfb-run
App.LinuxCommandLineArgs=-a wine "./DSPGAME.exe" -batchmode -nographics -nebula-server
App.WindowsCommandLineArgs=-batchmode -nographics -nebula-server
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}

App.CommandLineParameterFormat=-{0} {1}
App.CommandLineParameterDelimiter= 

App.EnvironmentVariables={"SteamAppId":"1366540","WINEPREFIX":"{{$FullInstanceDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","WINEDLLOVERRIDES":"winhttp=n,b"}

App.AdminMethod=STDIO
App.HasReadableConsole=True
App.HasWriteableConsole=True
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=quit
App.GracefulShutdownTime=30

Metrics.CpuUsage=True
Metrics.MemoryUsage=True
